{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for TextTop",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-destroy",
    "global-shortcut:default",
    "allow-load-notes",
    "allow-patch-note",
    "allow-close-note-data",
    "allow-restore-note",
    "allow-delete-closed-note",
    "allow-apply-theme",
    "allow-cycle-theme",
    "allow-touch-saved-at",
    "allow-create-note",
    "allow-open-note-window",
    "allow-close-note-window",
    "allow-update-note-window",
    "allow-set-note-always-on-top",
    "allow-get-settings",
    "allow-set-last-note-close",
    "allow-quit-app"
  ]
}
