{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "便签",
  "version": "1.0.0",
  "identifier": "com.texttop.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run icons && vite build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "便签",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "fullscreen": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}
