{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ArkNote",
  "version": "1.0.1",
  "identifier": "com.arknote.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DOCUMENT/**",
          "$DOCUMENT/ArkNote/**",
          "$APPDATA/**",
          "$APPDATA/com.arknote.app/**",
          "$APPDATA/com.texttop.app/**",
          "$RESOURCE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}
